# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=travel

# Database URL for running without Docker (set automatically inside Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5544/travel

# --- Art Institute of Chicago API (optional) ---
# ART_API_BASE_URL=https://api.artic.edu/api/v1
# ART_API_TIMEOUT_SECONDS=10
# ART_API_CACHE_TTL_SECONDS=3600

# LOG_LEVEL=INFO
